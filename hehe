function _G.CriarAba(nome)
    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(1, 0, 0, 32)
    TabButton.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    TabButton.Text = nome
