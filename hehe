    TabButton.Parent = _G.TabsFrame
    Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 6)
    
    _G.AbasAtivas[nome] = {}
    if _G.CurrentTab == "" then _G.CurrentTab = nome end
    TabButton.MouseButton1Click:Connect(function()
        _G.CurrentTab = nome
        for abaNome, componentes in pairs(_G.AbasAtivas) do
            local visivel = (abaNome == nome)
            for _, comp in pairs(componentes) do comp.Visible = visivel end
        end
    end)
end

function _G.CriarToggle(aba, texto, configChave)
    local ToggleBg = Instance.new("TextButton")
    ToggleBg.Size = UDim2.new(1, -10, 0, 35)
    ToggleBg.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    ToggleBg.Text = "  " .. texto
    ToggleBg.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBg.Font = Enum.Font.SourceSans
    ToggleBg.TextSize = 14
    ToggleBg.TextXAlignment = Enum.TextXAlignment.Left
    ToggleBg.Visible = (aba == _G.CurrentTab)
    ToggleBg.Parent = _G.ContentFrame
    Instance.new("UICorner", ToggleBg).CornerRadius = UDim.new(0, 6)

    local Indicador = Instance.new("Frame")
    Indicador.Size = UDim2.new(0, 35, 0, 18)
    Indicador.Position = UDim2.new(1, -95, 0.5, -9)
    Indicador.BackgroundColor3 = _G.ThurxzConfig[configChave] and Color3.fromRGB(160, 32, 240) or Color3.fromRGB(45, 45, 50)
    Indicador.Parent = ToggleBg
    Instance.new("UICorner", Indicador).CornerRadius = UDim.new(0, 9)

    local BindButton = Instance.new("TextButton")
    BindButton.Size = UDim2.new(0, 40, 0, 20)
    BindButton.Position = UDim2.new(1, -50, 0.5, -10)
    BindButton.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    BindButton.Text = "None"
    BindButton.TextColor3 = Color3.fromRGB(160, 32, 240)
    BindButton.Font = Enum.Font.SourceSansBold
    BindButton.TextSize = 11
    BindButton.Parent = ToggleBg
    Instance.new("UICorner", BindButton).CornerRadius = UDim.new(0, 4)

    local function atualizarEstado()
        Indicador.BackgroundColor3 = _G.ThurxzConfig[configChave] and Color3.fromRGB(160, 32, 240) or Color3.fromRGB(45, 45, 50)
        if _G.ThurxzConfig[configChave] then _G.MostrarNotificacao(texto) end
    end

    ToggleBg.MouseButton1Click:Connect(function()
        _G.ThurxzConfig[configChave] = not _G.ThurxzConfig[configChave]
        atualizarEstado()
    end)

    local escutandoTeclado = false
    BindButton.MouseButton1Click:Connect(function()
        if escutandoTeclado then return end
        escutandoTeclado = true BindButton.Text = "..." BindButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        local conexaoBind
        conexaoBind = UserInputService.InputBegan:Connect(function(input, processado)
            if processado then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                _G.ThurxzBinds[configChave] = input.KeyCode.Name
                BindButton.Text = input.KeyCode.Name
                BindButton.TextColor3 = Color3.fromRGB(160, 32, 240)
                escutandoTeclado = false conexaoBind:Disconnect()
            end
        end)
    end)

    UserInputService.InputBegan:Connect(function(input, processado)
        if processado then return end
        if _G.ThurxzBinds[configChave] and input.KeyCode.Name == _G.ThurxzBinds[configChave] then
            _G.ThurxzConfig[configChave] = not _G.ThurxzConfig[configChave]
            atualizarEstado()
        end
    end)
    table.insert(_G.AbasAtivas[aba], ToggleBg)
end

