local function obterInimigoMaisProximo()
    local menorDistancia = math.huge local alvoEscolhido = nil
    local centroDaTela = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if not (UserInputService.TouchEnabled and not UserInputService.MouseEnabled) then centroDaTela = UserInputService:GetMouseLocation() end
    for _, j in pairs(Players:GetPlayers()) do
        if j ~= LocalPlayer and j.Character and j.Character:FindFirstChild("HumanoidRootPart") then
            local head = j.Character:FindFirstChild("Head") local hum = j.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local posTela, visivel = Camera:WorldToViewportPoint(head.Position)
                if visivel then
                    local dist = (Vector2.new(posTela.X, posTela.Y) - centroDaTela).Magnitude
                    if _G.ThurxzConfig.AimbotFovCustom and dist <= _G.ThurxzConfig.FovSize and dist < menorDistancia then menorDistancia = dist alvoEscolhido = head
                    elseif not _G.ThurxzConfig.AimbotFovCustom and dist < menorDistancia then menorDistancia = dist alvoEscolhido = head end
                end
            end
        end
    end
    return alvoEscolhido
end

_G.FovCircle = Drawing.new("Circle") _G.FovCircle.Color = Color3.fromRGB(160, 32, 240) _G.FovCircle.Thickness = 1.5 _G.FovCircle.Filled = false _G.FovCircle.Transparency = 1 _G.FovCircle.Visible = false

local function criarEsp(jogador)
    local LinhaEsp = Drawing.new("Line") LinhaEsp.Color = Color3.fromRGB(160, 32, 240) LinhaEsp.Thickness = 1.5
    local CaixaEsp = Drawing.new("Square") CaixaEsp.Color = Color3.fromRGB(180, 50, 255) CaixaEsp.Thickness = 1.5 local conexao
    conexao = RunService.RenderStepped:Connect(function()
        if not jogador.Parent or not jogador.Character or not jogador.Character:FindFirstChild("HumanoidRootPart") then
            LinhaEsp.Visible = false CaixaEsp.Visible = false if not jogador.Parent then LinhaEsp:Remove() CaixaEsp:Remove() conexao:Disconnect() end return
        end
        local rootPart = jogador.Character.HumanoidRootPart local hum = jogador.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local posRaiz, visivel = Camera:WorldToViewportPoint(rootPart.Position)
            if visivel then
                if _G.ThurxzConfig.EspBox then
                    local alt = (Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0)).Y) local larg = alt / 2
                    CaixaEsp.Size = Vector2.new(larg, alt) CaixaEsp.Position = Vector2.new(posRaiz.X - larg / 2, posRaiz.Y - alt / 2) CaixaEsp.Visible = true
                else CaixaEsp.Visible = false end
                if _G.ThurxzConfig.EspLine then LinhaEsp.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y) LinhaEsp.To = Vector2.new(posRaiz.X, posRaiz.Y) LinhaEsp.Visible = true else LinhaEsp.Visible = false end
            else LinhaEsp.Visible = false CaixaEsp.Visible = false end
        else LinhaEsp.Visible = false CaixaEsp.Visible = false end
    end)
end
for _, j in pairs(Players:GetPlayers()) do if j ~= LocalPlayer then criarEsp(j) end end
Players.PlayerAdded:Connect(function(j) if j ~= LocalPlayer then criarEsp(j) end end)

GuiService.CaptureNotified:Connect(function(capturando)
    if _G.ThurxzConfig.StreamCheckBypass and capturando then
        if _G.FovCircle then _G.FovCircle.Visible = false end
        local antigoBox = _G.ThurxzConfig.EspBox local antigoLine = _G.ThurxzConfig.EspLine
        _G.ThurxzConfig.EspBox = false _G.ThurxzConfig.EspLine = false task.wait(0.6)
        _G.ThurxzConfig.EspBox = antigoBox _G.ThurxzConfig.EspLine = antigoLine
    end
end)

