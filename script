    function _G.CriarAba(no) 
        local b = Instance.new("TextButton", _G.TabsFrame) 
        b.Size = UDim2.new(1, 0, 0, 32) 
        b.BackgroundColor3 = Color3.fromRGB(18, 18, 22) 
        b.Text = no 
        b.TextColor3 = Color3.fromRGB(180, 180, 180) 
        b.Font = Enum.Font.SourceSansBold 
        b.TextSize = 13 
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6) 
        _G.AbasAtivas[no] = {} 
        if _G.CurrentTab == "" then _G.CurrentTab = no end 
        b.MouseButton1Click:Connect(function() 
            _G.CurrentTab = no 
            for an, cc in pairs(_G.AbasAtivas) do 
                local v = (an == no) 
                for _, cp in pairs(cc) do cp.Visible = v end 
            end 
        end) 
    end

    function _G.CriarToggle(ab, tx, ck) 
        local tb = Instance.new("TextButton", _G.ContentFrame) 
        tb.Size = UDim2.new(1, -10, 0, 35) 
        tb.BackgroundColor3 = Color3.fromRGB(18, 18, 22) 
        tb.Text = " " .. tx 
        tb.TextColor3 = Color3.fromRGB(255, 255, 255) 
        tb.Font = Enum.Font.SourceSans 
        tb.TextSize = 14 
        tb.TextXAlignment = Enum.TextXAlignment.Left 
        tb.Visible = (ab == _G.CurrentTab) 
        Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 6) 
        local Indicador = Instance.new("Frame", tb) 
        Indicador.Size = UDim2.new(0, 35, 0, 18) 
        Indicador.Position = UDim2.new(1, -95, 0.5, -9) 
        Indicador.BackgroundColor3 = _G.ThurxzConfig[ck] and Color3.fromRGB(160, 32, 240) or Color3.fromRGB(45, 45, 50) 
        Instance.new("UICorner", Indicador).CornerRadius = UDim.new(0, 9) 
        local bb = Instance.new("TextButton", tb) 
        bb.Size = UDim2.new(0, 40, 0, 20) 
        bb.Position = UDim2.new(1, -50, 0.5, -10) 
        bb.BackgroundColor3 = Color3.fromRGB(28, 28, 35) 
        bb.Text = "None" 
        bb.TextColor3 = Color3.fromRGB(160, 32, 240) 
        bb.Font = Enum.Font.SourceSansBold 
        bb.TextSize = 11 
        Instance.new("UICorner", bb).CornerRadius = UDim.new(0, 4) 
        local function up() 
            Indicador.BackgroundColor3 = _G.ThurxzConfig[ck] and Color3.fromRGB(160, 32, 240) or Color3.fromRGB(45, 45, 50) 
            if _G.ThurxzConfig[ck] then _G.MostrarNotificacao(tx) end 
        end 
        tb.MouseButton1Click:Connect(function() 
            _G.ThurxzConfig[ck] = not _G.ThurxzConfig[ck] 
            up() 
        end) 
        local lis = false 
        bb.MouseButton1Click:Connect(function() 
            if lis then return end 
            lis = true 
            bb.Text = "..." 
            local cb 
            cb = U.InputBegan:Connect(function(input, p) 
                if p then return end 
                if input.UserInputType == Enum.UserInputType.Keyboard then 
                    _G.ThurxzBinds[ck] = input.KeyCode.Name 
                    bb.Text = input.KeyCode.Name 
                    lis = false 
                    cb:Disconnect() 
                end 
            end) 
        end) 
        U.InputBegan:Connect(function(input, p) 
            if p then return end 
            if _G.ThurxzBinds[ck] and input.KeyCode.Name == _G.ThurxzBinds[ck] then 
                _G.ThurxzConfig[ck] = not _G.ThurxzConfig[ck] 
                up() 
            end 
        end) 
        table.insert(_G.AbasAtivas[ab], tb) 
    end

    function _G.CriarBotaoAcao(ab, tx, ac) 
        local b = Instance.new("TextButton", _G.ContentFrame) 
        b.Size = UDim2.new(1, -10, 0, 35) 
        b.BackgroundColor3 = Color3.fromRGB(120, 20, 180) 
        b.Text = tx 
        b.TextColor3 = Color3.fromRGB(255, 255, 255) 
        b.Font = Enum.Font.SourceSansBold 
        b.Visible = (ab == _G.CurrentTab) 
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6) 
        b.MouseButton1Click:Connect(ac) 
        table.insert(_G.AbasAtivas[ab], b) 
    end

    if _G.TipoDeJogoAtual == "RPG/Tiro" then 
        _G.CriarAba("RPG Combat") 
