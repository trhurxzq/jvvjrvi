        Instance.new("UICorner", nb).CornerRadius = UDim.new(0, 6) 
        local br = Instance.new("Frame", nb) 
        br.Size = UDim2.new(0, 4, 1, 0) 
        br.BackgroundColor3 = Color3.fromRGB(160, 32, 240) 
        local tx = Instance.new("TextLabel", nb) 
        tx.Size = UDim2.new(1, -15, 1, 0) 
        tx.Position = UDim2.new(0, 12, 0, 0) 
        tx.BackgroundTransparency = 1 
        tx.Text = no .. " ativa com sucesso" 
        tx.TextColor3 = Color3.fromRGB(255, 255, 255) 
        tx.Font = Enum.Font.SourceSansBold 
        tx.TextSize = 13 
        tx.TextXAlignment = Enum.TextXAlignment.Left 
        task.delay(3, function() if nb then nb:Destroy() end end) 
